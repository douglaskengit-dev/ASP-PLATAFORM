# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commitar .env.local (já está no .gitignore).

# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta — só usada no servidor (API routes), nunca no navegador
SUPABASE_SECRET_KEY=

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=
# Assistente (botão 🤖): modelo opcional; padrão claude-opus-5-5
ASSISTENTE_MODEL=

# E-mail — opcional (sem provedor, o e-mail é desativado e o in-app segue).
# Gmail via SMTP (passo a passo no README, "E-mail via Gmail"). Com SMTP_HOST
# definido, o SMTP tem precedência sobre o Resend.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# Senha de app do Google (16 caracteres; espaços são ignorados)
SMTP_PASS=
# Alternativa: Resend (usado quando SMTP_HOST está vazio)
RESEND_API_KEY=
# Força o provedor: smtp | resend (opcional)
EMAIL_PROVEDOR=
# Ex.: ASP <conta@gmail.com>  (no Gmail, o endereço precisa ser o SMTP_USER)
EMAIL_REMETENTE=
# Reply-To (opcional)
EMAIL_RESPONDER_PARA=
